modules = ["nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=1 npm run db:local && CLOUDFLARE_INCLUDE_PROCESS_ENV=true ADMIN_SECRET=\"$SESSION_SECRET\" npm run dev -- --ip 0.0.0.0 --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
